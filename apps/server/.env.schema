# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DATABASE_AUTH_TOKEN=

# @optional @sensitive=false
# Public VAPID key shared with browsers for push subscriptions.
VAPID_PUBLIC_KEY=

# @optional @sensitive
VAPID_PRIVATE_KEY=

# @optional @sensitive=false
# mailto: or https: subject for VAPID.
VAPID_SUBJECT=

# @optional @sensitive
# Bearer secret for POST /api/reminders/run when an external scheduler is used.
REMINDER_RUN_SECRET=
