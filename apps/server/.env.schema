# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @optional @public @type=url
# Browser-facing HTTPS origin for phone/PWA testing through a reverse proxy.
DEV_PUBLIC_ORIGIN=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=if(forEnv(development), fallback($DEV_PUBLIC_ORIGIN, http://localhost:3003))

# @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @public @type=url
CORS_ORIGIN=if(forEnv(development), $BETTER_AUTH_URL)

# @type=string(minLength=1)
DATABASE_URL=if(forEnv(development), http://127.0.0.1:8080)

# @required=not(forEnv(development, test))
# Local Turso runs without authentication; hosted databases require a token.
DATABASE_AUTH_TOKEN=

# @optional @sensitive=false
# Public VAPID key shared with browsers for push subscriptions.
VAPID_PUBLIC_KEY=

# @optional @sensitive
VAPID_PRIVATE_KEY=

# @optional @sensitive=false
# mailto: or https: subject for VAPID.
VAPID_SUBJECT=

# @optional @sensitive
# Bearer secret for POST /api/reminders/run when an external scheduler is used.
REMINDER_RUN_SECRET=
